# ── Production environment for Raspberry Pi ──
# Copy to backend/.env and fill in your API keys.

PORT=5000
NODE_ENV=production
AUTO_CRAWL_ON_START=true

# ── AI Provider API keys (optional; enter at least one) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ── Excel import paths (optional; defaults to root/*.xlsx) ──
# EXCEL_IMPORT_PATH=/home/pi/legal-case-monitoring/root/clean_data.xlsx
# HC_EXCEL_IMPORT_PATH=/home/pi/legal-case-monitoring/root/hc_legal_cases.xlsx

# ── CORS (comma-separated; defaults to localhost:5173 for dev) ──
# ALLOWED_ORIGINS=http://localhost:3000,http://my-domain.in
